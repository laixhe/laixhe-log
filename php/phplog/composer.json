{
    "name": "laixhe/phplog",
    "description": "PHP 学习项目：参考 Go golog 与 Rust rustlog 的标准库/常用库示例",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Laixhe\\Phplog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laixhe\\Phplog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "run": "php run.php"
    },
    "config": {
        "sort-packages": true
    }
}
